{
  "name": "@endge/nova",
  "private": false,
  "version": "0.13.8",
  "type": "module",
  "module": "./dist/nova.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nova.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "dev": "vite build --watch",
    "dev:watch": "vite build --watch",
    "build": "vite build",
    "pretest": "pnpm --filter @endge/utils build && pnpm --filter @endge/raph build",
    "test": "vitest run --config vite.config.ts",
    "test:perf": "vitest run --config vite.config.ts src/test/**/*.performance.test.ts",
    "bench": "NODE_OPTIONS=--max-old-space-size=8192 vitest bench --run --config vite.config.ts",
    "test:coverage": "vitest run --config vite.config.ts --coverage"
  },
  "dependencies": {
    "@endge/raph": "^3.0.4",
    "@endge/utils": "^0.25.0",
    "class-transformer": "^0.5.1",
    "gl-matrix": "^3.4.3",
    "rbush": "^4.0.1"
  },
  "devDependencies": {
    "@types/rbush": "^4.0.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vue/language-core": "^3.3.11",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "typescript": "~6.0.3",
    "unplugin-dts": "^1.0.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.11"
  }
}
